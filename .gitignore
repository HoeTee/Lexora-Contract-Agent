# Local secrets and deployment overrides
.env
.env.local
.env.*.local
/config.yaml
/docker-compose.yaml

# Runtime data and tenant identity
/data/*
!/data/.gitkeep
/profiles/*
!/profiles/.gitkeep
/logs/
/uploads/

# Real run outputs and generated indexes
logs/
outputs/
results/
reports/
RAG_persist/
*.log

# Office documents and temporary files
*.doc
*.docx
*.docm
*.dot
*.dotx
*.dotm
*.pdf
~$*
.~lock.*#
*.tmp
*.bak

# Keep the committed fallback review criteria
/resources/criteria/*
!/resources/criteria/.gitkeep
!/resources/criteria/criteria.docx

# Python environments, caches, and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/
env/
.ruff_cache/
.cache/
dist/
build/

# Local tool and editor state
.claude/
.codex/*
!.codex/agents/
!.codex/agents/*.toml
.vscode/
.idea/

# Entire local-only trees
/tests/
/scripts/
/packages/
/pageindex/
/deploy/

# Local dependency archives
*.tar
*.tar.gz
*.zip
*.rar
/image.tar

# Source-protection build artifacts
/protect/*.key
/protect/out/
/protect/tmp/
/protect/vmp/tools/
/protect/vmp/tmp_test/

# Local notes and generated documentation artifacts
/DEPLOYMENT.md
/PLAN.md
/docs/.$BUSINESS_USER_JOURNEY.drawio.bkp
/docs/portal/
/docs/superpowers/
/检索算法设计文档.txt
