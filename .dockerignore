.git/
.gitignore
.dockerignore
.github/
.agents/
.codex/

# Local secrets and deployment overrides
.env
.env.local
.env.*.local
/config.yaml
/docker-compose.yaml

# Runtime data is mounted by the host
/data/
/profiles/
/logs/
/uploads/

# Real run outputs and generated indexes
logs/
outputs/
results/
reports/
RAG_persist/
*.log

# Python environments, caches, and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/
.ruff_cache/
.cache/
dist/
build/

# Office documents and temporary files
*.doc
*.docx
*.docm
*.dot
*.dotx
*.dotm
*.pdf
!resources/criteria/
!resources/criteria/criteria.docx
~$*
.~lock.*#
*.tmp
*.bak

# Development-only trees and files
/tests/
/scripts/
/pageindex/
/deploy/
/docs/
/AGENTS.md
/DEPLOYMENT.md
/PLAN.md
/README.md
/Dockerfile
/docker-compose.example.yaml
/config.example.yaml
/requirements-dev.txt
/ruff.toml
/pyrightconfig.json

# Local dependency archives; /packages remains in the build context
*.tar
*.tar.gz
*.zip
*.rar
/image.tar

# Source-protection build artifacts
/protect/*.key
/protect/out/
/protect/tmp/
/protect/vmp/tools/
/protect/vmp/tmp_test/

# Local notes
/检索算法设计文档.txt
